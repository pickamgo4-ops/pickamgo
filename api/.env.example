# ===========================================
# Find It Near Me — Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real secrets.

# -------------------------------------------
# Application
# -------------------------------------------
NODE_ENV=development
PORT=4000

# Base application URL (used for links in emails, redirects, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# Backend public URL
# Development: http://localhost:4000
# Production: https://api.your-domain.com
BACKEND_URL=http://localhost:4000

# API path prefix (usually /api)
API_PREFIX=/api

# Frontend URL (for CORS and redirects)
# Development: http://localhost:3000
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# -------------------------------------------
# Database
# -------------------------------------------
# PostgreSQL (local or Railway): DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="postgresql://user:password@host:5432/pickamgo?schema=public"

# -------------------------------------------
# Authentication
# -------------------------------------------
JWT_SECRET=change-me-in-production-to-a-long-random-string

# -------------------------------------------
# Paystack
# -------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# -------------------------------------------
# Email (Resend)
# -------------------------------------------
RESEND_API_KEY=

# -------------------------------------------
# Storage (Cloudflare R2)
# -------------------------------------------
# Leave empty to use local disk storage (development)
# Set these values to use Cloudflare R2 in production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: R2 public URL if bucket is public
# R2_PUBLIC_URL=
