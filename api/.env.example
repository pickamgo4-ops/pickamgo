# ===========================================
# Find It Near Me — Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real secrets.

# -------------------------------------------
# Application
# -------------------------------------------
NODE_ENV=development
PORT=4000

# Base application URL (used for links in emails, redirects, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# Backend public URL
# Development: http://localhost:4000
# Production: https://api.your-domain.com
BACKEND_URL=http://localhost:4000

# API path prefix (usually /api)
API_PREFIX=/api

# Frontend URL (for CORS and redirects)
# Development: http://localhost:3000
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Root domain used to allow shop subdomain requests through API CORS.
MARKETPLACE_DOMAIN=pickamgo.com

# -------------------------------------------
# Database
# -------------------------------------------
# PostgreSQL (local or Railway): DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL="postgresql://user:password@host:5432/pickamgo?schema=public"

# -------------------------------------------
# Authentication
# -------------------------------------------
JWT_SECRET=change-me-in-production-to-a-long-random-string

# Arkesel SMS OTP configuration. Keep these backend-only; never use NEXT_PUBLIC_ names.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=PickAmGo
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Must match the frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=806419638142-pkegcrntdkn3abahd3q4ti50fff1uol4.apps.googleusercontent.com

# -------------------------------------------
# Paystack
# -------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# -------------------------------------------
# Email (Resend)
# -------------------------------------------
RESEND_API_KEY=
RESEND_FROM_NAME=PickAmGo

# Default sender address used when no specific purpose is provided
RESEND_FROM_EMAIL=noreply@pickamgo.com

# Role-based sender addresses on the verified pickamgo.com domain
# These are sender identities; they do not require separate mailboxes.
RESEND_HELLO_EMAIL=hello@pickamgo.com
RESEND_SUPPORT_EMAIL=support@pickamgo.com
RESEND_ORDERS_EMAIL=orders@pickamgo.com
RESEND_ACCOUNTS_EMAIL=accounts@pickamgo.com
RESEND_PAYMENTS_EMAIL=payments@pickamgo.com
RESEND_PAYOUTS_EMAIL=payouts@pickamgo.com
RESEND_SELLERS_EMAIL=sellers@pickamgo.com
RESEND_RIDERS_EMAIL=riders@pickamgo.com
RESEND_BOOKINGS_EMAIL=bookings@pickamgo.com
RESEND_MESSAGES_EMAIL=messages@pickamgo.com
RESEND_NOTIFICATIONS_EMAIL=notifications@pickamgo.com
RESEND_ADMIN_EMAIL=admin@pickamgo.com
RESEND_SECURITY_EMAIL=security@pickamgo.com
RESEND_MARKETING_EMAIL=marketing@pickamgo.com
RESEND_NOREPLY_EMAIL=noreply@pickamgo.com

ADMIN_NOTIFICATION_EMAIL=

# Email branding
# Public URL to the logo used in email headers
LOGO_URL=https://pickamgo.com/logo.png
# Public URL to the BIMI SVG logo (must be hosted on the same domain as the sending address)
# Example: https://pickamgo.com/bimi.svg
BIMI_LOGO_URL=https://pickamgo.com/bimi.svg

# -------------------------------------------
# Storage (Cloudflare R2)
# -------------------------------------------
# Leave empty to use local disk storage (development)
# Set these values to use Cloudflare R2 in production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: R2 public URL if bucket is public
# R2_PUBLIC_URL=
