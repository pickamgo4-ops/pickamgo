generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  phone                  String?
  passwordHash           String
  name                   String
  avatar                 String?
  location               String
  isSeller               Boolean                 @default(false)
  isRider                Boolean                 @default(false)
  isAdmin                Boolean                 @default(false)
  suspended              Boolean?                @default(false)
  banned                 Boolean?                @default(false)
  emailVerified          Boolean                 @default(false)
  phoneVerified          Boolean                 @default(false)
  authVersion            Int                     @default(0)
  lastActiveAt           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  addresses              Address[]
  auditLogs              AuditLog[]
  customerBookings       Booking[]               @relation("BookingCustomer")
  providerBookings       Booking[]               @relation("BookingProvider")
  cart                   Cart?
  receivedConversations1 Conversation[]          @relation("ConversationParticipant1")
  receivedConversations2 Conversation[]          @relation("ConversationParticipant2")
  deliveries             Delivery[]
  customerDisputes       Dispute[]               @relation("DisputeCustomer")
  sellerDisputes         Dispute[]               @relation("DisputeSeller")
  emailCampaigns         EmailCampaign[]
  refundedOrders         Refund[]                @relation("RefundSeller")
  receivedRefunds        Refund[]                @relation("RefundCustomer")
  favorites              Favorite[]
  ledgerEntries          FinancialLedger[]
  sentMessages           Message[]
  notifications          Notification[]
  notificationPrefs      NotificationPreference?
  customerOrders         Order[]                 @relation("OrderCustomer")
  riderOrders            Order[]                 @relation("OrderRider")
  sellerOrders           Order[]                 @relation("OrderSeller")
  passwordResetTokens    PasswordResetToken[]
  emailVerifications     EmailVerification[]
  payouts                Payout[]
  payoutMethods          PayoutMethod[]
  products               Product[]
  createdPromos          PromoCode[]             @relation("PromoCreatedBy")
  createdNotices         PublicNotice[]          @relation("PublicNoticeCreatedBy")
  sellerPromos           PromoCode[]             @relation("PromoSeller")
  reports                Report[]
  reviews                Review[]
  reviewResponses        ReviewResponse[]
  disputeMessages        DisputeMessage[]
  riderProfile           Rider?
  riderEarnings          RiderEarnings[]
  searchHistory          SearchHistory[]
  sellerEarnings         SellerEarnings[]
  verification           SellerVerification?
  risk                   SellerRisk?
  payoutFreeze           SellerPayoutFreeze?
  messageModerations     MessageModeration[]
  uploadedEvidence       OrderEvidence[]         @relation("OrderEvidenceUploader")
  custodyEvents          OrderCustodyEvent[]
  fraudAlerts            FraudAlert[]
  services               Service[]
  ownedShops             Shop[]                  @relation("ShopOwner")
  followedShops          ShopFollow[]
  roles                  UserRole[]
  loginHistory           LoginHistory[]
  phoneOtps              PhoneOtp[]
  loginChallenges        LoginChallenge[]
  accountAppeals         AccountAppeal[]       @relation("AccountAppealUser")
  reviewedAccountAppeals AccountAppeal[]       @relation("AccountAppealReviewer")
  payoutDisclaimerAcceptances PayoutDisclaimerAcceptance[]
  accountStatus          String                @default("ACTIVE")
  restrictionReason      String?
  statusChangedAt        DateTime?
  sellerTourStatus       String?               @default("NOT_STARTED")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id          String   @id @default(cuid())
  userId      String
  email       String
  code        String
  hashedCode  String   @unique
  expiresAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '10 minutes')"))
  used        Boolean  @default(false)
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([hashedCode])
}

model PhoneOtp {
  id          String    @id @default(cuid())
  userId      String?
  phoneNumber String
  otpHash     String
  purpose     String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([phoneNumber, purpose, createdAt])
  @@index([expiresAt])
}

model LoginChallenge {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  method        String?
  codeHash      String?
  codeExpiresAt DateTime?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  used          Boolean   @default(false)
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  device        String?
  browser       String?
  os            String?
  location      String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  address      String
  city         String
  area         String?
  campus       String?
  region       String?
  country      String?
  phone        String?
  instructions String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SellerVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  fullName              String
  phoneNumber           String
  sellerType            String?
  businessName          String?
  businessDescription   String?
  businessType          String?
  businessReg           String?
  location              String?
  intendedSell          String?
  agreedToTerms         Boolean   @default(false)
  agreedAt              DateTime?
  idNumber              String?
  idType                String?
  idFrontUrl            String?
  idBackUrl             String?
  selfieUrl             String?
  type                    String    @default("SELLER")
  status                  String    @default("PENDING")
  reviewStatus            String?   @default("UNDER_REVIEW")
  rejectionReason         String?
  reviewedAt              DateTime?
  reviewedBy              String?
  verificationMethod      String?
  verificationProvider    String?
  verificationReference   String?
  verificationDate        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reviewStatus])
  @@index([verificationMethod])
}

model SellerVerificationHistory {
  id             String    @id @default(cuid())
  userId         String
  verificationId String
  statusFrom     String?
  statusTo       String
  reason         String?
  changedBy      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([verificationId])
  @@index([createdAt])
}

model SellerRisk {
  id            String    @id @default(cuid())
  userId        String    @unique
  riskLevel     String    @default("NORMAL")
  trustScore    Int       @default(50)
  flags         String?
  lastCheckedAt DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
  @@index([trustScore])
}

model SellerPayoutFreeze {
  id        String    @id @default(cuid())
  userId    String    @unique
  frozenBy  String
  reason    String
  frozenAt  DateTime  @default(now())
  thawedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([thawedAt])
}

model PayoutMethodChange {
  id               String   @id @default(cuid())
  userId           String
  payoutMethodId   String
  changedByUserId  String
  changeReason     String?
  confirmedVia     String?
  changedAt        DateTime @default(now())
  isUnusual        Boolean  @default(false)
  previousPhoneLast4 String?
  newPhoneLast4     String?
  previousNameHash   String?
  newNameHash        String?
  ipAddress          String?
  userAgent          String?

  @@index([userId])
  @@index([payoutMethodId])
  @@index([changedByUserId])
  @@index([isUnusual])
}

model ShopCategory {
  id          String         @id @default(cuid())
  shopId      String
  name        String
  description String?
  image       String?
  parentId    String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]
  services    Service[]
  parent      ShopCategory?  @relation("ShopCategoryHierarchy", fields: [parentId], references: [id])
  children    ShopCategory[] @relation("ShopCategoryHierarchy")
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
}

model ProductVariant {
  id            String     @id @default(cuid())
  productId     String
  name          String
  sku           String?
  price         Decimal?   @db.Decimal(12, 2)
  originalPrice Decimal?   @db.Decimal(12, 2)
  stock         Int        @default(0)
  image         String?
  attributes    String?
  isActive      Boolean    @default(true)
  isLowStock    Boolean    @default(false)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]

  @@index([productId])
  @@index([sku])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  abandonedCart AbandonedCart?

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String?
  serviceId String?
  variantId String?
  quantity  Int             @default(1)
  price     Decimal         @db.Decimal(12, 2)
  name      String
  image     String
  shopId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, serviceId, variantId])
  @@index([cartId])
}

model Shop {
  id                      String             @id @default(cuid())
  ownerId                 String
  name                    String
  slug                    String             @unique
  logo                    String
  banner                  String?
  description             String
  location                String
  area                    String?
  campus                  String?
  latitude                Float?
  longitude               Float?
  status                  String?            @default("ACTIVE")
  verificationStatus      String             @default("PENDING")
  isVerified              Boolean            @default(false)
  isOpen                  Boolean            @default(true)
  isBookingEnabled        Boolean            @default(false)
  openingHours            String
  deliveryAvailable       Boolean            @default(true)
  pickupAvailable         Boolean            @default(true)
  sellerDeliveryAvailable Boolean            @default(false)
  deliveryFee             Decimal            @default(0) @db.Decimal(12, 2)
  platformDeliveryFee     Decimal            @default(10) @db.Decimal(12, 2)
  sellerDeliveryFee       Decimal            @default(0) @db.Decimal(12, 2)
  allowGuestCheckout      Boolean            @default(false)
  pickupInstructions      String?
  deliveryZones           String?
  followersCount          Int                @default(0)
  rating                  Float              @default(0)
  reviewsCount            Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  bookings                Booking[]
  conversations           Conversation[]     @relation("ShopConversations")
  orders                  Order[]
  products                Product[]
  services                Service[]
  owner                   User               @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shopCategories          ShopCategory[]
  customization           ShopCustomization?
  followers               ShopFollow[]
  updates                 ShopUpdate[]
  staff                   Staff[]
  bookingRule             BookingRule?
  shippingZones           ShippingZone[]
  collections             ProductCollection[]
  promotions              ProductPromotion[]
  qrCode                  SellerQrCode?

  @@index([ownerId])
  @@index([slug])
  @@index([campus])
  @@index([status])
}

model ShopCustomization {
  id                         String    @id @default(cuid())
  shopId                     String    @unique
  draftTheme                 String    @default("CLEAN")
  draftLayout                String    @default("CLASSIC")
  draftPrimaryColor          String    @default("#FF6B35")
  draftSecondaryColor        String    @default("#FFF5E6")
  draftAccentColor           String    @default("#2C1F15")
  draftLogo                  String?
  draftCoverImage            String?
  draftProfileImage          String?
  draftDescription           String?
  draftAnnouncement          String?
  draftFeaturedProductId     String?
  draftShowReviews           Boolean   @default(true)
  draftShowCategories        Boolean   @default(true)
  draftShowFeatured          Boolean   @default(true)
  draftShowServices          Boolean   @default(true)
  draftHeaderStyle            String    @default("STANDARD")
  draftBannerStyle            String    @default("COVER")
  draftProductCardStyle       String    @default("SOFT")
  draftProductColumns         Int       @default(4)
  draftShowAbout              Boolean   @default(true)
  draftShowHours              Boolean   @default(true)
  draftShowContact            Boolean   @default(true)
  draftSectionOrder           String    @default("featured,products,services,reviews,about")
  publishedAt                DateTime?
  publishedTheme             String?
  publishedLayout            String?
  publishedPrimaryColor      String?
  publishedSecondaryColor    String?
  publishedAccentColor       String?
  publishedLogo              String?
  publishedCoverImage        String?
  publishedProfileImage      String?
  publishedDescription       String?
  publishedAnnouncement      String?
  publishedFeaturedProductId String?
  publishedShowReviews       Boolean?
  publishedShowCategories    Boolean?
  publishedShowFeatured      Boolean?
  publishedShowServices      Boolean?
  publishedHeaderStyle         String?
  publishedBannerStyle         String?
  publishedProductCardStyle    String?
  publishedProductColumns     Int?
  publishedShowAbout           Boolean?
  publishedShowHours           Boolean?
  publishedShowContact         Boolean?
  publishedSectionOrder        String?
  customizationVersion       Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  shop                       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String?    @unique
  description  String?
  image        String?
  emoji        String
  color        String
  parentId     String?
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  services     Service[]

  @@index([parentId])
  @@index([slug])
  @@index([displayOrder])
}

model Product {
  id                 String              @id @default(cuid())
  shopId             String
  sellerId           String
  categoryId         String
  shopCategoryId     String?
  name               String
  description        String
  shortDescription   String?
  sku                String?             @unique
  slug               String?             @unique
  brand              String?
  price              Decimal             @db.Decimal(12, 2)
  originalPrice      Decimal?            @db.Decimal(12, 2)
  discount           Int?
  stock              Int                 @default(0)
  condition          String              @default("new")
  status             String              @default("ACTIVE")
  location           String
  area               String?
  campus             String?
   isTrending         Boolean             @default(false)
   isNew              Boolean             @default(false)
   isDeal             Boolean             @default(false)
   rating             Float               @default(0)
   reviewsCount       Int                 @default(0)
   draft              Boolean             @default(false)
   publishedAt        DateTime?
   moderationStatus   String              @default("APPROVED")
   moderationNotes    String?
   moderatedBy        String?
   moderatedAt        DateTime?
   createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cartItems          CartItem[]
  orderItems         OrderItem[]
  category           Category            @relation(fields: [categoryId], references: [id])
  seller             User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopCategory       ShopCategory?       @relation(fields: [shopCategoryId], references: [id])
  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  variants           ProductVariant[]
  views              ProductView[]
  inventoryMovements InventoryMovement[]
  collectionItems   CollectionProduct[]
  promotionItems    PromotionProduct[]
  flashSaleProducts FlashSaleProduct[]
  engagements       ProductEngagement[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([campus])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model ShippingZone {
  id                 String   @id @default(cuid())
  shopId             String
  name               String
  region             String?
  city               String?
  area               String?
  locations          String?
  deliveryFee        Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryFrom   Decimal? @db.Decimal(12, 2)
  estimatedDelivery  String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, isActive])
  @@index([city, area])
}

model ProductCollection {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  slug        String
  description String?
  imageUrl    String?
  isVisible   Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    CollectionProduct[]

  @@unique([shopId, slug])
  @@index([shopId, isVisible, sortOrder])
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model ProductPromotion {
  id             String   @id @default(cuid())
  shopId         String
  name           String
  type           String   @default("CLEARANCE")
  discountType   String
  discountValue  Decimal  @db.Decimal(12, 2)
  startsAt       DateTime
  endsAt         DateTime
  maxQuantity    Int?
  bannerUrl      String?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products       PromotionProduct[]

  @@index([shopId, status, startsAt, endsAt])
}

model PromotionProduct {
  promotionId String
  productId   String
  originalPrice Decimal @db.Decimal(12, 2)
  finalPrice    Decimal @db.Decimal(12, 2)
  unitsSold     Int     @default(0)
  createdAt     DateTime @default(now())
  promotion     ProductPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model SellerQrCode {
  id          String   @id @default(cuid())
  shopId      String   @unique
  publicToken String   @unique @default(cuid())
  scanCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scans       SellerQrScan[]
}

model SellerQrScan {
  id         String   @id @default(cuid())
  qrCodeId   String
  scannedAt  DateTime @default(now())
  referrer   String?
  qrCode     SellerQrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, scannedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Service {
  id                  String                @id @default(cuid())
  shopId              String
  providerId          String
  categoryId          String
  shopCategoryId      String?
  name                String
  description         String
  price               Decimal               @db.Decimal(12, 2)
  originalPrice       Decimal?              @db.Decimal(12, 2)
  duration            String
  minNoticeHours      Int                   @default(0)
  maxAdvanceDays      Int                   @default(30)
  bufferMinutes       Int                   @default(0)
  allowStaffSelection Boolean               @default(true)
  requireApproval     Boolean               @default(false)
  staffRequired       Boolean               @default(false)
  location            String
  area                String?
  campus              String?
  isVerified          Boolean               @default(false)
  isTrending          Boolean               @default(false)
  rating              Float                 @default(0)
  reviewsCount        Int                   @default(0)
  status              String                @default("ACTIVE")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  bookings            Booking[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  category            Category              @relation(fields: [categoryId], references: [id])
  provider            User                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  shopCategory        ShopCategory?         @relation(fields: [shopCategoryId], references: [id])
  shop                Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  availability        ServiceAvailability[]
  images              ServiceImage[]
  staffServices       StaffService[]

  @@index([providerId])
  @@index([categoryId])
  @@index([campus])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAvailability {
  id          String   @id @default(cuid())
  serviceId   String
  date        String
  timeSlots   String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([serviceId])
}

model Booking {
  id         String   @id @default(cuid())
  serviceId  String
  customerId String?
  providerId String?
  shopId     String
  date       String
  timeSlot   String
  staffId    String?
  staffName  String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  status     String   @default("PENDING")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User?    @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  provider   User?    @relation("BookingProvider", fields: [providerId], references: [id], onDelete: SetNull)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
