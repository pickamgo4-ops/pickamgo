generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  passwordHash  String
  name          String
  avatar        String?
  location      String
  isSeller      Boolean  @default(false)
  isRider       Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles                  UserRole[]
  ownedShops             Shop[]                  @relation("ShopOwner")
  products               Product[]
  services               Service[]
  customerOrders         Order[]                 @relation("OrderCustomer")
  sellerOrders           Order[]                 @relation("OrderSeller")
  riderOrders            Order[]                 @relation("OrderRider")
  customerBookings       Booking[]               @relation("BookingCustomer")
  providerBookings       Booking[]               @relation("BookingProvider")
  reviews                Review[]
  favorites              Favorite[]
  followedShops          ShopFollow[]
  riderProfile           Rider?
  deliveries             Delivery[]
  notifications          Notification[]
  addresses              Address[]
  verification           SellerVerification?
  cart                   Cart?
  notificationPrefs      NotificationPreference?
  sentMessages           Message[]
  receivedConversations1 Conversation[]          @relation("ConversationParticipant1")
  receivedConversations2 Conversation[]          @relation("ConversationParticipant2")
  reports                Report[]
  customerDisputes       Dispute[]               @relation("DisputeCustomer")
  sellerDisputes         Dispute[]               @relation("DisputeSeller")
  searchHistory          SearchHistory[]
  payoutMethods          PayoutMethod[]
  payouts                Payout[]
  sellerEarnings         SellerEarnings[]
  riderEarnings          RiderEarnings[]
  ledgerEntries          FinancialLedger[]
  passwordResetTokens    PasswordResetToken[]
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  users       UserRole[]
  createdAt   DateTime   @default(now())
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  address   String
  city      String
  area      String?
  campus    String?
  region    String?
  country   String?
  phone     String?
  instructions String?
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SellerVerification {
  id              String    @id @default(cuid())
  userId          String    @unique
  fullName        String
  phoneNumber     String
  idNumber        String?
  idType          String?
  idFrontUrl      String?
  idBackUrl       String?
  selfieUrl       String?
  businessName    String?
  businessType    String?
  businessReg     String?
  type            String    @default("SELLER")
  status          String    @default("PENDING")
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ShopCategory {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String?
  image       String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent   ShopCategory?  @relation("ShopCategoryHierarchy", fields: [parentId], references: [id])
  children ShopCategory[] @relation("ShopCategoryHierarchy")
  products Product[]
  services Service[]

  @@unique([shopId, name])
  @@index([shopId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  sku        String?
  price      Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  image      String?
  attributes String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
  @@unique([sessionId])
  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  serviceId String?
  variantId String?
  quantity  Int      @default(1)
  price     Decimal @db.Decimal(12, 2)
  name      String
  image     String
  shopId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@unique([cartId, productId, serviceId, variantId])
  @@index([cartId])
}

model Shop {
  id                      String   @id @default(cuid())
  ownerId                 String
  name                    String
  slug                    String   @unique
  logo                    String
  banner                  String?
  description             String
  location                String
  area                    String?
  campus                  String?
  latitude                Float?
  longitude               Float?
  status                  String   @default("ACTIVE")
  verificationStatus      String   @default("PENDING")
  isVerified              Boolean  @default(false)
  isOpen                  Boolean  @default(true)
  openingHours            String
  deliveryAvailable       Boolean  @default(true)
  pickupAvailable         Boolean  @default(true)
  sellerDeliveryAvailable Boolean  @default(false)
  deliveryFee             Decimal  @db.Decimal(12, 2) @default(0)
  platformDeliveryFee     Decimal  @db.Decimal(12, 2) @default(10)
  sellerDeliveryFee       Decimal  @db.Decimal(12, 2) @default(0)
  pickupInstructions      String?
  deliveryZones           String? // JSON
  followersCount          Int      @default(0)
  rating                  Float    @default(0)
  reviewsCount            Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  owner          User               @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  products       Product[]
  services       Service[]
  followers      ShopFollow[]
  orders         Order[]
  bookings       Booking[]
  shopCategories ShopCategory[]
  updates        ShopUpdate[]
  customization  ShopCustomization?
  conversations  Conversation[] @relation("ShopConversations")

  @@index([ownerId])
  @@index([slug])
  @@index([campus])
}

model ShopCustomization {
  id                         String    @id @default(cuid())
  shopId                     String    @unique
  draftTheme                 String    @default("CLEAN")
  draftLayout                String    @default("CLASSIC")
  draftPrimaryColor          String    @default("#FF6B35")
  draftSecondaryColor        String    @default("#FFF5E6")
  draftAccentColor           String    @default("#2C1F15")
  draftLogo                  String?
  draftCoverImage            String?
  draftProfileImage          String?
  draftDescription           String?
  draftAnnouncement          String?
  draftFeaturedProductId     String?
  draftShowReviews           Boolean   @default(true)
  draftShowCategories        Boolean   @default(true)
  draftShowFeatured          Boolean   @default(true)
  draftShowServices          Boolean   @default(true)
  publishedAt                DateTime?
  publishedTheme             String?
  publishedLayout            String?
  publishedPrimaryColor      String?
  publishedSecondaryColor    String?
  publishedAccentColor       String?
  publishedLogo              String?
  publishedCoverImage        String?
  publishedProfileImage      String?
  publishedDescription       String?
  publishedAnnouncement      String?
  publishedFeaturedProductId String?
  publishedShowReviews       Boolean?
  publishedShowCategories    Boolean?
  publishedShowFeatured      Boolean?
  publishedShowServices      Boolean?
  customizationVersion       Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  emoji       String
  color       String
  parentId    String?
  isActive    Boolean  @default(true)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  services Service[]

  @@index([parentId])
  @@index([slug])
  @@index([displayOrder])
}

model Product {
  id             String   @id @default(cuid())
  shopId         String
  sellerId       String
  categoryId     String
  shopCategoryId String?
  name           String
  description    String
  price          Decimal @db.Decimal(12, 2)
  originalPrice  Decimal? @db.Decimal(12, 2)
  discount       Int?
  stock          Int      @default(0)
  condition      String   @default("new")
  status         String   @default("ACTIVE")
  location       String
  area           String?
  campus         String?
  isTrending     Boolean  @default(false)
  isNew          Boolean  @default(false)
  isDeal         Boolean  @default(false)
  rating         Float    @default(0)
  reviewsCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seller       User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category         @relation(fields: [categoryId], references: [id])
  shopCategory ShopCategory?    @relation(fields: [shopCategoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  views        ProductView[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([campus])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Service {
  id             String   @id @default(cuid())
  shopId         String
  providerId     String
  categoryId     String
  shopCategoryId String?
  name           String
  description    String
  price          Decimal @db.Decimal(12, 2)
  originalPrice  Decimal? @db.Decimal(12, 2)
  duration       String
  location       String
  area           String?
  campus         String?
  isVerified     Boolean  @default(false)
  isTrending     Boolean  @default(false)
  rating         Float    @default(0)
  reviewsCount   Int      @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider     User                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category     Category              @relation(fields: [categoryId], references: [id])
  shopCategory ShopCategory?         @relation(fields: [shopCategoryId], references: [id])
  images       ServiceImage[]
  availability ServiceAvailability[]
  bookings     Booking[]
  orderItems   OrderItem[]
  cartItems    CartItem[]

  @@index([providerId])
  @@index([categoryId])
  @@index([campus])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model ServiceImage {
  id        String @id @default(cuid())
  serviceId String
  url       String
  sortOrder Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAvailability {
  id          String   @id @default(cuid())
  serviceId   String
  date        String
  timeSlots   String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([serviceId])
}

model Booking {
  id         String   @id @default(cuid())
  serviceId  String
  customerId String
  providerId String
  shopId     String
  date       String
  timeSlot   String
  status     String   @default("PENDING")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User    @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider User    @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  shop     Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([serviceId, providerId, date, timeSlot])
  @@index([serviceId])
  @@index([customerId])
  @@index([providerId])
  @@index([shopId])
  @@index([date])
}

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  customerId        String?
  guestName         String?
  guestPhone        String?
  guestEmail        String?
  shopId            String
  sellerId          String
  total             Decimal  @db.Decimal(12, 2)
  status            String   @default("PENDING_PAYMENT")
  deliveryAddress   String
  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryFee       Decimal  @db.Decimal(12, 2) @default(0)
  deliveryStatus    String   @default("PENDING")
  riderId           String?
  estimatedDelivery String?
  notes             String?
  fulfillmentMethod String   @default("FIND_IT_NEAR_ME_RIDER") // FIND_IT_NEAR_ME_RIDER, SELLER_OWN_DELIVERY, CUSTOMER_PICKUP
  payoutEligible    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer       User?             @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seller         User              @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  rider          User?             @relation("OrderRider", fields: [riderId], references: [id])
  items          OrderItem[]
  payment        Payment?
  delivery       Delivery?
  disputes       Dispute[]
  sellerEarnings SellerEarnings?
  riderEarnings  RiderEarnings?
  ledgerEntries  FinancialLedger[]
  conversations  Conversation[]

  @@index([customerId])
  @@index([shopId])
  @@index([sellerId])
  @@index([riderId])
  @@index([status])
  @@index([riderId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  serviceId String?
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)
  name      String
  image     String

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([orderId])
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  method         String
  provider       String
  status         String    @default("PENDING")
  transactionRef String    @unique
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionRef])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  userAvatar String
  targetType String
  targetId   String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([userId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model ShopFollow {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
}

model Rider {
  id              String   @id @default(cuid())
  userId          String   @unique
  isOnline        Boolean  @default(false)
  isAvailable     Boolean  @default(false)
  rating          Float    @default(0)
  deliveriesCount Int      @default(0)
  earnings        Decimal  @db.Decimal(12, 2) @default(0)
  vehicleType     String?
  licenseNumber   String?
  isVerified      Boolean  @default(false)
  currentLatitude Float?
  currentLongitude Float?
  locationUpdatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Delivery {
  id              String    @id @default(cuid())
  orderId         String    @unique
  riderId         String?
  pickupLocation  String
  dropoffLocation String
  pickupAddress   String
  dropoffAddress  String
  pickupLatitude  Float?
  pickupLongitude Float?
  dropoffLatitude Float?
  dropoffLongitude Float?
  status          String    @default("PENDING")
  distance        String?
  fee             Decimal   @db.Decimal(12, 2) @default(0)
  riderEarnings   Decimal   @db.Decimal(12, 2) @default(0)
  acceptedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider               User?          @relation(fields: [riderId], references: [id])
  riderEarningsRecord RiderEarnings?

  @@index([riderId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  orders    Boolean  @default(true)
  shops     Boolean  @default(true)
  deals     Boolean  @default(true)
  delivery  Boolean  @default(true)
  beauty    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id             String   @id @default(cuid())
  participant1Id String
  participant2Id String
  shopId         String?
  orderId        String?
  closedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participant1 User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  shop         Shop?     @relation("ShopConversations", fields: [shopId], references: [id], onDelete: Cascade)
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([participant1Id])
  @@index([participant2Id])
  @@index([shopId])
  @@index([orderId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  category       String    // FRAUD, PAYMENT_ISSUE, WRONG_PRODUCT, HARASSMENT, FAKE_SHOP, ORDER_PROBLEM, DELIVERY_PROBLEM, SUSPICIOUS_ACTIVITY, OTHER
  targetType     String    // PRODUCT, SHOP, SELLER, ORDER, CUSTOMER, RIDER, MESSAGE, PAYMENT, USER, OTHER
  targetId       String
  reason         String
  description    String?
  attachmentUrl  String?
  status         String    @default("NEW") // NEW, REVIEWING, RESOLVED, DISMISSED
  adminNotes     String?
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model Dispute {
  id          String   @id @default(cuid())
  orderId     String
  customerId  String
  sellerId    String
  type        String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation("DisputeCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  seller   User  @relation("DisputeSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([sessionId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  query     String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([query])
}

model ShopUpdate {
  id        String   @id @default(cuid())
  shopId    String
  title     String
  content   String
  type      String   @default("UPDATE")
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model PayoutMethod {
  id          String   @id @default(cuid())
  userId      String
  type        String // 'mobile_money'
  provider    String // 'MTN', 'VODAFONE', 'AIRTELTIGO'
  phoneNumber String
  accountName String?
  isDefault   Boolean  @default(false)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([userId])
}

model Payout {
  id                 String    @id @default(cuid())
  userId             String
  payoutMethodId     String
  amount             Decimal   @db.Decimal(12, 2)
  currency           String    @default("GHS")
  status             String    @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED, REVERSED, CANCELLED
  reference          String    @unique
  paystackTransferId String?
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutMethod PayoutMethod @relation(fields: [payoutMethodId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([reference])
}

model FinancialLedger {
  id          String   @id @default(cuid())
  userId      String?
  orderId     String?
  payoutId    String?
  type        String // ORDER_PAYMENT, SELLER_EARNING, PLATFORM_COMMISSION, DELIVERY_EARNING, PAYOUT, REFUND, REVERSAL
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("GHS")
  status      String   @default("PENDING")
  reference   String   @unique
  description String?
  metadata    String? // JSON string
  createdAt   DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
}

model SellerEarnings {
  id          String    @id @default(cuid())
  sellerId    String
  orderId     String    @unique
  grossAmount Decimal @db.Decimal(12, 2)
  platformFee Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @db.Decimal(12, 2)
  netAmount   Decimal @db.Decimal(12, 2)
  status      String    @default("PENDING") // PENDING, AVAILABLE, WITHDRAWN, REFUNDED
  availableAt DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller User  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([sellerId, status, createdAt])
}

model RiderEarnings {
  id          String    @id @default(cuid())
  riderId     String
  deliveryId  String    @unique
  orderId     String    @unique
  grossAmount Decimal @db.Decimal(12, 2)
  platformFee Decimal @db.Decimal(12, 2)
  netAmount   Decimal @db.Decimal(12, 2)
  status      String    @default("PENDING") // PENDING, AVAILABLE, WITHDRAWN, REVERSED
  availableAt DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rider    User     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
  @@index([riderId, status, availableAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String?
  description String?
  type        String?  @default("string")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model EmailLog {
  id            String   @id @default(cuid())
  to            String
  subject       String
  type          String
  userId        String?
  relatedId     String?
  status        String   @default("pending")
  messageId     String?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([relatedId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
