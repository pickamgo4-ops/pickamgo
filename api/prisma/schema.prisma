  text           String?
  audiences      String
  recipientCount Int       @default(0)
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("PENDING")
  sentBy         String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  sender         User?     @relation(fields: [sentBy], references: [id], onDelete: SetNull)

  @@index([sentBy])
}

model PromoCode {
  id                  String            @id @default(cuid())
  code                String            @unique @db.VarChar(50)
  campaignName        String?
  description         String?
  discountType        String            @default("PERCENTAGE")
  discountValue       Decimal           @db.Decimal(12, 2)
  maxDiscount         Decimal?          @db.Decimal(12, 2)
  minimumOrderAmount  Decimal           @default(0) @db.Decimal(12, 2)
  fundingType         String            @default("SELLER")
  usageLimit          Int?
  usageCount          Int               @default(0)
  usagePerCustomer    Int?
  startAt             DateTime
  endAt               DateTime
  status              String            @default("DRAFT")
  appliesTo           String?
  shopIds             String?
  productIds          String?
  categoryIds         String?
  campuses            String?
  customerEligibility String            @default("EVERYONE")
  discountAppliesTo   String            @default("PRODUCTS")
  campaignBudget      Decimal?          @db.Decimal(12, 2)
  campaignSpent       Decimal           @default(0) @db.Decimal(12, 2)
  createdBy           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sellerId            String?
  orders              Order[]           @relation("PromoOrders")
  createdByUser       User?             @relation("PromoCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  seller              User?             @relation("PromoSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  redemptions         PromoRedemption[]

  @@index([code])
  @@index([status])
  @@index([createdBy])
  @@index([sellerId])
  @@index([startAt, endAt])
}

model PromoRedemption {
  id                   String    @id @default(cuid())
  promoCodeId          String
  orderId              String    @unique
  customerId           String?
  guestIdentifier      String?
  originalSubtotal     Decimal   @db.Decimal(12, 2)
  discountAmount       Decimal   @db.Decimal(12, 2)
  discountedSubtotal   Decimal   @db.Decimal(12, 2)
  deliveryDiscount     Decimal   @default(0) @db.Decimal(12, 2)
  fundingSource        String
  sellerPayout         Decimal   @db.Decimal(12, 2)
  pickamgoCommission   Decimal   @db.Decimal(12, 2)
  pickamgoPromoExpense Decimal   @default(0) @db.Decimal(12, 2)
  sellerFundedDiscount Decimal   @default(0) @db.Decimal(12, 2)
  createdAt            DateTime  @default(now())
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promoCode            PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
}

model PublicNotice {
  id                 String                  @id @default(cuid())
  title              String
  message            String                  @db.Text
  type               String                  @default("INFORMATION")
  icon               String?
  imageUrl           String?
  buttonText         String?
  buttonUrl          String?
  linkTarget         String                  @default("_self")
  pageTargets        String                  @default("ALL")
  audience           String                  @default("EVERYONE")
  priority           Int                     @default(0)
  status             String                  @default("DRAFT")
  isDismissible      Boolean                 @default(true)
  rememberDismissal  Boolean                 @default(true)
  reappearAfterHours Int?                    @default(24)
  startsAt           DateTime?
  endsAt             DateTime?
  createdBy          String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdByUser      User?                   @relation("PublicNoticeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  dismissals         PublicNoticeDismissal[]

  @@index([status])
  @@index([type])
  @@index([startsAt, endsAt])
  @@index([priority])
  @@index([createdBy])
  @@index([createdAt])
}

model PublicNoticeDismissal {
  id          String       @id @default(cuid())
  noticeId    String
  userId      String?
  sessionId   String?
  dismissedAt DateTime     @default(now())
  notice      PublicNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@unique([noticeId, sessionId])
  @@index([noticeId])
  @@index([userId])
  @@index([sessionId])
  @@index([dismissedAt])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  device       String?
  browser      String?
  os           String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  revokedReason String?
  isCurrent    Boolean  @default(false)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([lastActiveAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  key         String   @unique
  userId      String?
  scope       String
  status      String   @default("PROCESSING")
  response    String?
  statusCode  Int?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@index([userId])
  @@index([scope, createdAt])
  @@index([expiresAt])
}

model AccountChangeEvent {
  id          String   @id @default(cuid())
  userId      String
  changeType  String
  oldValue    String?
  newValue    String?
  ipAddress   String?
  userAgent   String?
  actorId     String?
  verifiedVia String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([changeType])
  @@index([createdAt])
}

model SystemKillSwitch {
  key         String   @id
  enabled     Boolean  @default(false)
  reason      String?
  enabledBy   String?
  enabledAt   DateTime?
  disabledBy  String?
  disabledAt  DateTime?
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AccountRestriction {
  id        String   @id @default(cuid())
  userId    String
  capability String
  status    String   @default("RESTRICTED")
  reason    String?
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, capability])
  @@index([userId])
  @@index([capability])
  @@index([expiresAt])
}

model RiderRiskSignal {
  id        String   @id @default(cuid())
  riderId   String
  signal    String
  weight    Int      @default(1)
  metadata  String?
  createdAt DateTime @default(now())

  @@index([riderId])
  @@index([signal])
  @@index([createdAt])
}

model EvidenceRevision {
  id            String   @id @default(cuid())
  evidenceId    String
  orderId       String
  uploaderId    String
  previousFileUrl String?
  newFileUrl    String?
  previousNote  String?
  newNote       String?
  previousStatus String?
  newStatus     String?
  replacedBy    String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([evidenceId])
  @@index([orderId])
  @@index([createdAt])
}

model RefundAbuseSignal {
  id         String   @id @default(cuid())
  customerId String
  orderId    String
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  userName  String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([userId])
}

model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model DisputeMessage {
  id          String   @id @default(cuid())
  disputeId   String
  senderId    String
  senderRole  String
  content     String
  attachmentUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([senderId])
}

model AbandonedCart {
  id              String   @id @default(cuid())
  cartId          String   @unique
  userId          String?
  sessionId       String?
  itemsCount      Int
  subtotal        Decimal  @db.Decimal(12, 2)
  recovered       Boolean  @default(false)
  recoveryToken   String?  @unique
  lastRemindedAt  DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([recovered])
  @@index([expiresAt])
}

model FlashSale {
  id            String   @id @default(cuid())
  name          String
  description   String?
  discountType  String
  discountValue Decimal  @db.Decimal(12, 2)
  maxQuantity   Int?
  soldCount     Int      @default(0)
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("ACTIVE")
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  products      FlashSaleProduct[]

  @@index([status, startsAt, endsAt])
}

model FlashSaleProduct {
  flashSaleId String
  productId   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([flashSaleId, productId])
  @@index([productId])
}
