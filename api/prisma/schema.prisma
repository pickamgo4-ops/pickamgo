generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  phone                  String?
  passwordHash           String
  name                   String
  avatar                 String?
  location               String
  isSeller               Boolean                 @default(false)
  isRider                Boolean                 @default(false)
  isAdmin                Boolean                 @default(false)
  suspended              Boolean?                @default(false)
  banned                 Boolean?                @default(false)
  emailVerified          Boolean                 @default(false)
  phoneVerified          Boolean                 @default(false)
  lastActiveAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  addresses              Address[]
  auditLogs              AuditLog[]
  customerBookings       Booking[]               @relation("BookingCustomer")
  providerBookings       Booking[]               @relation("BookingProvider")
  cart                   Cart?
   receivedConversations1 Conversation[]          @relation("ConversationParticipant1")
   receivedConversations2 Conversation[]          @relation("ConversationParticipant2")
   deliveries             Delivery[]
   customerDisputes       Dispute[]               @relation("DisputeCustomer")
   sellerDisputes         Dispute[]               @relation("DisputeSeller")
   emailCampaigns         EmailCampaign[]
   refundedOrders         Refund[]                @relation("RefundSeller")
   receivedRefunds        Refund[]                @relation("RefundCustomer")
  favorites              Favorite[]
  ledgerEntries          FinancialLedger[]
  sentMessages           Message[]
  notifications          Notification[]
  notificationPrefs      NotificationPreference?
  customerOrders         Order[]                 @relation("OrderCustomer")
  riderOrders            Order[]                 @relation("OrderRider")
  sellerOrders           Order[]                 @relation("OrderSeller")
  passwordResetTokens    PasswordResetToken[]
  emailVerifications     EmailVerification[]
  payouts                Payout[]
  payoutMethods          PayoutMethod[]
  products               Product[]
  createdPromos          PromoCode[]             @relation("PromoCreatedBy")
  createdNotices         PublicNotice[]          @relation("PublicNoticeCreatedBy")
  sellerPromos           PromoCode[]             @relation("PromoSeller")
  reports                Report[]
  reviews                Review[]
  riderProfile           Rider?
  riderEarnings          RiderEarnings[]
  searchHistory          SearchHistory[]
  sellerEarnings         SellerEarnings[]
  verification           SellerVerification?
  services               Service[]
  ownedShops             Shop[]                  @relation("ShopOwner")
  followedShops          ShopFollow[]
  roles                  UserRole[]
  loginHistory           LoginHistory[]
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  code      String
  hashedCode String  @unique
  expiresAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + INTERVAL '10 minutes')"))
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  maxAttempts Int    @default(5)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([hashedCode])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  device        String?
  browser       String?
  os            String?
  location      String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  address      String
  city         String
  area         String?
  campus       String?
  region       String?
  country      String?
  phone        String?
  instructions String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SellerVerification {
  id              String    @id @default(cuid())
  userId          String    @unique
  fullName        String
  phoneNumber     String
  idNumber        String?
  idType          String?
  idFrontUrl      String?
  idBackUrl       String?
  selfieUrl       String?
  businessName    String?
  businessType    String?
  businessReg     String?
  type            String    @default("SELLER")
  status          String    @default("PENDING")
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ShopCategory {
  id          String         @id @default(cuid())
  shopId      String
  name        String
  description String?
  image       String?
  parentId    String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]
  services    Service[]
  parent      ShopCategory?  @relation("ShopCategoryHierarchy", fields: [parentId], references: [id])
  children    ShopCategory[] @relation("ShopCategoryHierarchy")
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
}

model ProductVariant {
  id            String    @id @default(cuid())
  productId     String
  name          String
  sku           String?
  price         Decimal?  @db.Decimal(12, 2)
  originalPrice Decimal?  @db.Decimal(12, 2)
  stock         Int       @default(0)
  image         String?
  attributes    String?
  isActive      Boolean   @default(true)
  isLowStock    Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]

  @@index([productId])
  @@index([sku])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  serviceId String?
  variantId String?
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2)
  name      String
  image     String
  shopId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  service   Service? @relation(fields: [serviceId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, serviceId, variantId])
  @@index([cartId])
}

model Shop {
  id                      String             @id @default(cuid())
  ownerId                 String
  name                    String
  slug                    String             @unique
  logo                    String
  banner                  String?
  description             String
  location                String
  area                    String?
  campus                  String?
  latitude                Float?
  longitude               Float?
  status                  String?            @default("ACTIVE")
  verificationStatus      String             @default("PENDING")
  isVerified              Boolean            @default(false)
  isOpen                  Boolean            @default(true)
  openingHours            String
  deliveryAvailable       Boolean            @default(true)
  pickupAvailable         Boolean            @default(true)
  sellerDeliveryAvailable Boolean            @default(false)
  deliveryFee             Decimal            @default(0) @db.Decimal(12, 2)
  platformDeliveryFee     Decimal            @default(10) @db.Decimal(12, 2)
  sellerDeliveryFee       Decimal            @default(0) @db.Decimal(12, 2)
  allowGuestCheckout      Boolean            @default(false)
  pickupInstructions      String?
  deliveryZones           String?
  followersCount          Int                @default(0)
  rating                  Float              @default(0)
  reviewsCount            Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  bookings                Booking[]
  conversations           Conversation[]     @relation("ShopConversations")
  orders                  Order[]
  products                Product[]
  services                Service[]
  owner                   User               @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shopCategories          ShopCategory[]
  customization           ShopCustomization?
  followers               ShopFollow[]
  updates                 ShopUpdate[]
  staff                   Staff[]
  bookingRule             BookingRule?

  @@index([ownerId])
  @@index([slug])
  @@index([campus])
  @@index([status])
}

model ShopCustomization {
  id                         String    @id @default(cuid())
  shopId                     String    @unique
  draftTheme                 String    @default("CLEAN")
  draftLayout                String    @default("CLASSIC")
  draftPrimaryColor          String    @default("#FF6B35")
  draftSecondaryColor        String    @default("#FFF5E6")
  draftAccentColor           String    @default("#2C1F15")
  draftLogo                  String?
  draftCoverImage            String?
  draftProfileImage          String?
  draftDescription           String?
  draftAnnouncement          String?
  draftFeaturedProductId     String?
  draftShowReviews           Boolean   @default(true)
  draftShowCategories        Boolean   @default(true)
  draftShowFeatured          Boolean   @default(true)
  draftShowServices          Boolean   @default(true)
  publishedAt                DateTime?
  publishedTheme             String?
  publishedLayout            String?
  publishedPrimaryColor      String?
  publishedSecondaryColor    String?
  publishedAccentColor       String?
  publishedLogo              String?
  publishedCoverImage        String?
  publishedProfileImage      String?
  publishedDescription       String?
  publishedAnnouncement      String?
  publishedFeaturedProductId String?
  publishedShowReviews       Boolean?
  publishedShowCategories    Boolean?
  publishedShowFeatured      Boolean?
  publishedShowServices      Boolean?
  customizationVersion       Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  shop                       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String?    @unique
  description  String?
  image        String?
  emoji        String
  color        String
  parentId     String?
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @updatedAt
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  services     Service[]

  @@index([parentId])
  @@index([slug])
  @@index([displayOrder])
}

model Product {
  id              String           @id @default(cuid())
  shopId          String
  sellerId        String
  categoryId      String
  shopCategoryId  String?
  name            String
  description     String
  shortDescription String?
  sku             String?          @unique
  slug            String?          @unique
  brand           String?
  price           Decimal          @db.Decimal(12, 2)
  originalPrice   Decimal?         @db.Decimal(12, 2)
  discount        Int?
  stock           Int              @default(0)
  condition       String           @default("new")
  status          String           @default("ACTIVE")
  location        String
  area            String?
  campus          String?
  isTrending      Boolean          @default(false)
  isNew           Boolean          @default(false)
  isDeal          Boolean          @default(false)
  rating          Float            @default(0)
  reviewsCount    Int              @default(0)
  draft           Boolean          @default(false)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cartItems       CartItem[]
  orderItems      OrderItem[]
  category        Category         @relation(fields: [categoryId], references: [id])
  seller          User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shopCategory    ShopCategory?    @relation(fields: [shopCategoryId], references: [id])
  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  variants        ProductVariant[]
  views           ProductView[]
  inventoryMovements InventoryMovement[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([campus])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Service {
  id             String                @id @default(cuid())
  shopId         String
  providerId     String
  categoryId     String
  shopCategoryId String?
  name           String
  description    String
  price          Decimal               @db.Decimal(12, 2)
  originalPrice  Decimal?              @db.Decimal(12, 2)
  duration       String
  minNoticeHours       Int      @default(0)
  maxAdvanceDays       Int      @default(30)
  bufferMinutes        Int      @default(0)
  allowStaffSelection  Boolean  @default(true)
  requireApproval      Boolean  @default(false)
  staffRequired        Boolean  @default(false)
  location       String
  area           String?
  campus         String?
  isVerified     Boolean               @default(false)
  isTrending     Boolean               @default(false)
  rating         Float                 @default(0)
  reviewsCount   Int                   @default(0)
  status         String                @default("ACTIVE")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  bookings       Booking[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  category       Category              @relation(fields: [categoryId], references: [id])
  provider       User                  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  shopCategory   ShopCategory?         @relation(fields: [shopCategoryId], references: [id])
  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  availability   ServiceAvailability[]
  images         ServiceImage[]
  staffServices  StaffService[]

  @@index([providerId])
  @@index([categoryId])
  @@index([campus])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model ServiceImage {
  id        String  @id @default(cuid())
  serviceId String
  url       String
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServiceAvailability {
  id          String   @id @default(cuid())
  serviceId   String
  date        String
  timeSlots   String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([serviceId])
}

model Booking {
  id         String   @id @default(cuid())
  serviceId  String
  customerId String
  providerId String
  shopId     String
  date       String
  timeSlot   String
  staffId     String?
  staffName   String?
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  status     String   @default("PENDING")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider   User     @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([serviceId, providerId, date, timeSlot])
  @@index([serviceId])
  @@index([customerId])
  @@index([providerId])
  @@index([shopId])
  @@index([date])
}

model Staff {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  role        String
  description String?
  avatar      String?
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  services    StaffService[]
  availabilities StaffAvailability[]
  bookings    Booking[]

  @@index([shopId])
  @@index([isActive])
}

model StaffService {
  id        String   @id @default(cuid())
  staffId   String
  serviceId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model StaffAvailability {
  id          String   @id @default(cuid())
  staffId     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  breakStart  String?
  breakEnd    String?
  isAvailable Boolean  @default(true)
  isDayOff    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model BookingRule {
  id                    String   @id @default(cuid())
  shopId                String   @unique
  autoConfirm           Boolean  @default(false)
  requireDeposit        Boolean  @default(false)
  depositAmount         Decimal? @db.Decimal(12, 2)
  minBookingNoticeHours Int      @default(2)
  maxAdvanceBookingDays Int      @default(30)
  cancellationHours     Int      @default(24)
  bufferTimeMinutes     Int      @default(0)
  allowStaffSelection   Boolean  @default(true)
  allowTimeSelection    Boolean  @default(true)
  maxBookingsPerDay     Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique
  customerId         String?
  guestName          String?
  guestPhone         String?
  guestEmail         String?
  shopId             String
  sellerId           String
  total              Decimal           @db.Decimal(12, 2)
  status             String            @default("PENDING_PAYMENT")
  deliveryAddress    String
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  deliveryFee        Decimal           @default(0) @db.Decimal(12, 2)
  deliveryStatus     String            @default("PENDING")
  riderId            String?
  estimatedDelivery  String?
  notes              String?
  fulfillmentMethod  String            @default("FIND_IT_NEAR_ME_RIDER")
  payoutEligible     Boolean           @default(false)
  isTestOrder        Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  discountedSubtotal Decimal           @db.Decimal(12, 2)
  originalSubtotal   Decimal           @db.Decimal(12, 2)
   promoCodeId        String?
   promoDiscount      Decimal           @default(0) @db.Decimal(12, 2)
   refundId           String?
   conversations      Conversation[]
   delivery           Delivery?
   disputes           Dispute[]
   ledgerEntries      FinancialLedger[]
   customer           User?             @relation("OrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)
   promoCode          PromoCode?        @relation("PromoOrders", fields: [promoCodeId], references: [id])
   refund             Refund?
   rider              User?             @relation("OrderRider", fields: [riderId], references: [id])
  seller             User              @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items              OrderItem[]
  payment            Payment?
  redemption         PromoRedemption?
  riderEarnings      RiderEarnings?
  sellerEarnings     SellerEarnings?

  @@index([customerId])
  @@index([shopId])
  @@index([sellerId])
  @@index([riderId])
  @@index([status])
  @@index([riderId, status])
  @@index([isTestOrder])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String?
  serviceId          String?
  variantId          String?
  sku                String?
  variantName        String?
  variantAttributes  String?
  quantity           Int      @default(1)
  price              Decimal  @db.Decimal(12, 2)
  name               String
  image              String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product? @relation(fields: [productId], references: [id])
  service            Service? @relation(fields: [serviceId], references: [id])

  @@index([orderId])
}

model Payment {
  id             String    @id @default(cuid())
  orderId        String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  method         String
  provider       String
  status         String    @default("PENDING")
  transactionRef String    @unique
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionRef])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  reference   String   @unique
  eventType   String
  status      String   @default("PROCESSED")
  provider    String   @default("PAYSTACK")
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model Refund {
  id              String    @id @default(cuid())
  orderId         String    @unique
  sellerId        String
  customerId      String?
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("GHS")
  reason          String?
  status          String    @default("PENDING")
  adminNotes      String?
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller          User      @relation("RefundSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  customer        User?     @relation("RefundCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  userAvatar String
  targetType String
  targetId   String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([userId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

model ShopFollow {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
}

model Rider {
  id                String    @id @default(cuid())
  userId            String    @unique
  status            String    @default("ACTIVE")
  isOnline          Boolean   @default(false)
  isAvailable       Boolean   @default(false)
  rating            Float     @default(0)
  deliveriesCount   Int       @default(0)
  earnings          Decimal   @default(0) @db.Decimal(12, 2)
  vehicleType       String?
  licenseNumber     String?
  isVerified        Boolean   @default(false)
  currentLatitude   Float?
  currentLongitude  Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Delivery {
  id                  String         @id @default(cuid())
  orderId             String         @unique
  riderId             String?
  pickupLocation      String
  dropoffLocation     String
  pickupAddress       String
  dropoffAddress      String
  pickupLatitude      Float?
  pickupLongitude     Float?
  dropoffLatitude     Float?
  dropoffLongitude    Float?
  status              String         @default("PENDING")
  distance            String?
  fee                 Decimal        @default(0) @db.Decimal(12, 2)
  riderEarnings       Decimal        @default(0) @db.Decimal(12, 2)
  acceptedAt          DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime       @default(now())
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider               User?          @relation(fields: [riderId], references: [id])
  riderEarningsRecord RiderEarnings?

  @@index([riderId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  orders    Boolean  @default(true)
  shops     Boolean  @default(true)
  deals     Boolean  @default(true)
  delivery  Boolean  @default(true)
  beauty    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id             String    @id @default(cuid())
  participant1Id String
  participant2Id String
  shopId         String?
  orderId        String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  participant1   User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  shop           Shop?     @relation("ShopConversations", fields: [shopId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([participant1Id])
  @@index([participant2Id])
  @@index([shopId])
  @@index([orderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model Report {
  id            String    @id @default(cuid())
  reporterId    String
  category      String
  targetType    String
  targetId      String
  reason        String
  description   String?
  attachmentUrl String?
  status        String    @default("NEW")
  adminNotes    String?
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reporter      User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model Dispute {
  id          String   @id @default(cuid())
  orderId     String
  customerId  String
  sellerId    String
   type        String
   description String
   amount      Decimal? @db.Decimal(12, 2)
   resolution  String?
   status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    User     @relation("DisputeCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller      User     @relation("DisputeSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([sessionId])
}

model InventoryMovement {
  id            String   @id @default(cuid())
  productId     String
  variantId     String?
  sku           String?
  change        Int
  previousStock Int
  newStock      Int
  reason        String
  orderId       String?
  userId        String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([createdAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  query     String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([query])
}

model ShopUpdate {
  id        String   @id @default(cuid())
  shopId    String
  title     String
  content   String
  type      String   @default("UPDATE")
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model PayoutMethod {
  id          String   @id @default(cuid())
  userId      String
  type        String
  provider    String
  phoneNumber String
  accountName String?
  isDefault   Boolean  @default(false)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  payouts     Payout[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payout {
  id                 String       @id @default(cuid())
  userId             String
  payoutMethodId     String
  amount             Decimal      @db.Decimal(12, 2)
  currency           String       @default("GHS")
  status             String       @default("PENDING")
  reference          String       @unique
  paystackTransferId String?
  failureReason      String?
  processedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  payoutMethod       PayoutMethod @relation(fields: [payoutMethodId], references: [id])
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([reference])
}

model FinancialLedger {
  id          String   @id @default(cuid())
  userId      String?
  orderId     String?
  payoutId    String?
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("GHS")
  status      String   @default("PENDING")
  reference   String   @unique
  description String?
  metadata    String?
  createdAt   DateTime @default(now())
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
}

model SellerEarnings {
  id            String    @id @default(cuid())
  sellerId      String
  orderId       String    @unique
  grossAmount   Decimal   @db.Decimal(12, 2)
  platformFee   Decimal   @db.Decimal(12, 2)
  deliveryFee   Decimal   @db.Decimal(12, 2)
  netAmount     Decimal   @db.Decimal(12, 2)
  status        String    @default("PENDING")
  availableAt   DateTime?
  withdrawnAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  promoDiscount Decimal   @default(0) @db.Decimal(12, 2)
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([sellerId, status, createdAt])
}

model RiderEarnings {
  id          String    @id @default(cuid())
  riderId     String
  deliveryId  String    @unique
  orderId     String    @unique
  grossAmount Decimal   @db.Decimal(12, 2)
  platformFee Decimal   @db.Decimal(12, 2)
  netAmount   Decimal   @db.Decimal(12, 2)
  status      String    @default("PENDING")
  availableAt DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider       User      @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
  @@index([riderId, status, availableAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String?
  description String?
  type        String?  @default("string")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

model EmailLog {
  id        String    @id @default(cuid())
  to        String
  subject   String
  type      String
  userId    String?
  relatedId String?
  status    String    @default("pending")
  messageId String?
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([relatedId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model EmailCampaign {
  id             String    @id @default(cuid())
  subject        String
  html           String
  text           String?
  audiences      String
  recipientCount Int       @default(0)
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  status         String    @default("PENDING")
  sentBy         String
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  sender         User      @relation(fields: [sentBy], references: [id])

  @@index([sentBy])
}

model PromoCode {
  id                  String            @id @default(cuid())
  code                String            @unique @db.VarChar(50)
  campaignName        String?
  description         String?
  discountType        String            @default("PERCENTAGE")
  discountValue       Decimal           @db.Decimal(12, 2)
  maxDiscount         Decimal?          @db.Decimal(12, 2)
  minimumOrderAmount  Decimal           @default(0) @db.Decimal(12, 2)
  fundingType         String            @default("SELLER")
  usageLimit          Int?
  usageCount          Int               @default(0)
  usagePerCustomer    Int?
  startAt             DateTime
  endAt               DateTime
  status              String            @default("DRAFT")
  appliesTo           String?
  shopIds             String?
  productIds          String?
  categoryIds         String?
  campuses            String?
  customerEligibility String            @default("EVERYONE")
  discountAppliesTo   String            @default("PRODUCTS")
  campaignBudget      Decimal?          @db.Decimal(12, 2)
  campaignSpent       Decimal           @default(0) @db.Decimal(12, 2)
  createdBy           String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sellerId            String?
  orders              Order[]           @relation("PromoOrders")
  createdByUser       User              @relation("PromoCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  seller              User?             @relation("PromoSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  redemptions         PromoRedemption[]

  @@index([code])
  @@index([status])
  @@index([createdBy])
  @@index([sellerId])
  @@index([startAt, endAt])
}

model PromoRedemption {
  id                   String    @id @default(cuid())
  promoCodeId          String
  orderId              String    @unique
  customerId           String?
  guestIdentifier      String?
  originalSubtotal     Decimal   @db.Decimal(12, 2)
  discountAmount       Decimal   @db.Decimal(12, 2)
  discountedSubtotal   Decimal   @db.Decimal(12, 2)
  deliveryDiscount     Decimal   @default(0) @db.Decimal(12, 2)
  fundingSource        String
  sellerPayout         Decimal   @db.Decimal(12, 2)
  pickamgoCommission   Decimal   @db.Decimal(12, 2)
  pickamgoPromoExpense Decimal   @default(0) @db.Decimal(12, 2)
  sellerFundedDiscount Decimal   @default(0) @db.Decimal(12, 2)
  createdAt            DateTime  @default(now())
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promoCode            PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([orderId])
  @@index([customerId])
  @@index([createdAt])
}

model PublicNotice {
  id             String    @id @default(cuid())
  title          String
  message        String    @db.Text
  type           String    @default("INFORMATION")
  icon           String?
  imageUrl       String?
  buttonText     String?
  buttonUrl      String?
  linkTarget     String    @default("_self")
  pageTargets    String    @default("ALL")
  audience       String    @default("EVERYONE")
  priority       Int       @default(0)
  status         String    @default("DRAFT")
  isDismissible  Boolean   @default(true)
  rememberDismissal Boolean @default(true)
  reappearAfterHours Int?   @default(24)
  startsAt       DateTime?
  endsAt         DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdByUser  User      @relation("PublicNoticeCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  dismissals     PublicNoticeDismissal[]

  @@index([status])
  @@index([type])
  @@index([startsAt, endsAt])
  @@index([priority])
  @@index([createdBy])
  @@index([createdAt])
}

model PublicNoticeDismissal {
  id         String    @id @default(cuid())
  noticeId   String
  userId     String?
  sessionId  String?
  dismissedAt DateTime @default(now())
  notice     PublicNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@unique([noticeId, sessionId])
  @@index([noticeId])
  @@index([userId])
  @@index([sessionId])
  @@index([dismissedAt])
}
