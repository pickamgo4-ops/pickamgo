# ===========================================
# Find It Near Me — Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* variables are exposed to the browser.

# -------------------------------------------
# API Configuration
# -------------------------------------------
# Backend API URL
# Development: http://localhost:4000/api
# Production: https://api.your-domain.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Google OAuth web client ID. Create this in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=806419638142-pkegcrntd3abahd3q4ti50fff1uol4.apps.googleusercontent.com

# Marketplace root domain used for shop subdomains in production.
# Cloudflare deployments also define this public value in wrangler.jsonc.
NEXT_PUBLIC_MARKETPLACE_DOMAIN=pickamgo.com

# -------------------------------------------
# Application URL
# -------------------------------------------
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# Payments
# -------------------------------------------
# Paystack public key (safe to expose to browser)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# -------------------------------------------
# Maps
# -------------------------------------------
# Mapbox public token (safe to expose to browser)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
